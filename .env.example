# =============================================================================
# PhishGuard - Environment Configuration
# =============================================================================
# Copy this file to `.env` and adjust values for your environment.
# All variables have safe defaults for local development.

# ---- Application ----------------------------------------------------------- #
# PHISHGUARD_ENV=development          # development | staging | production
# PHISHGUARD_DEBUG=false              # Enable debug logging and /api/docs
# PHISHGUARD_TESTING=false            # Set by test suite only

# ---- Database -------------------------------------------------------------- #
# DATABASE_URL=sqlite:///phishguard.db   # SQLite (default) or PostgreSQL URL

# ---- Authentication -------------------------------------------------------- #
# JWT_SECRET=                         # REQUIRED in production; random per-process if unset
# ACCESS_TOKEN_MINUTES=120            # JWT token lifetime
# COOKIE_SECURE=false                 # Set true when serving over HTTPS

# ---- Admin bootstrap ------------------------------------------------------- #
# ADMIN_EMAIL=                        # Auto-create admin user on startup
# ADMIN_PASSWORD=                     # (both must be set)

# ---- SMTP (password reset emails) ----------------------------------------- #
# SMTP_HOST=                          # Empty = log reset links to console
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=phishguard@localhost
# PUBLIC_BASE_URL=http://127.0.0.1:8000   # Base URL for links in emails

# ---- Safe fetching / SSRF ------------------------------------------------- #
# FETCH_CONNECT_TIMEOUT=5.0           # Seconds
# FETCH_READ_TIMEOUT=8.0
# FETCH_TOTAL_TIMEOUT=10.0            # Wall-clock budget per fetch (all hops)
# FETCH_MAX_BYTES=2097152             # 2 MB max response body
# FETCH_MAX_REDIRECTS=8
# FETCH_USER_AGENT=Mozilla/5.0 (compatible; PhishGuard/1.0; +defensive-phishing-research)
# ALLOWED_PORTS=80,443,8080,8443,8000,8888
# BLOCKED_HOSTNAMES=                  # Comma-separated extra blocked hostnames

# ---- Rate limiting --------------------------------------------------------- #
# RATE_LIMIT_SCANS_PER_MINUTE_IP=10
# RATE_LIMIT_SCANS_PER_MINUTE_SESSION=10
# RATE_LIMIT_AUTH_PER_MINUTE_IP=10
# MAX_CONCURRENT_SCANS=4
# SCAN_TOTAL_TIMEOUT=30.0             # Total wall-clock for analysis pipeline
# TRUST_PROXY_HEADERS=false           # Honour X-Forwarded-For (set true behind proxy)

# ---- Domain intelligence --------------------------------------------------- #
# DNS_TIMEOUT=4.0
# RDAP_TIMEOUT=6.0
# RDAP_BOOTSTRAP_URL=https://rdap.org/domain/
# ENABLE_WHOIS_FALLBACK=true
# ENABLE_ASN_LOOKUP=true
# GOOGLE_SAFE_BROWSING_API_KEY=       # Empty = reputation "not configured"
# TRANCO_LIST_PATH=backend/data/tranco_top.csv
# TRANCO_TOP_N=100000

# ---- Machine learning ------------------------------------------------------ #
# ML_MODEL_PATH=ml/model.pkl
# ML_METRICS_PATH=ml/metrics.json

# ---- Risk engine ----------------------------------------------------------- #
# WEIGHT_ML=0.30
# WEIGHT_RULES=0.35
# WEIGHT_WEBPAGE=0.20
# WEIGHT_DOMAIN=0.15
# RISK_BAND_MODERATE=30
# RISK_BAND_HIGH=60
# RISK_BAND_CRITICAL=80
# ML_SUSPICIOUS_THRESHOLD=0.40
# ML_PHISHING_THRESHOLD=0.70

# ---- HTTP server ----------------------------------------------------------- #
# CORS_ORIGINS=                       # Comma-separated origins (empty = disabled)
